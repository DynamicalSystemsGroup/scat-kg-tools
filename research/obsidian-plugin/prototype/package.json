{
  "name": "scat-check-obsidian",
  "version": "0.0.1",
  "description": "Prototype Obsidian plugin that shows `scat check` messages.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "typecheck": "tsc -noEmit -skipLibCheck",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
