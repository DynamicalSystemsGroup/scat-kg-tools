# STACK B rules as SHACL. Every shape carries scat:ruleId; the mapping layer in check.py reads it.
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix scat:  <https://example.org/scat-placeholder#> .
@prefix shape: <https://example.org/scat-placeholder/shape#> .

<https://example.org/scat-placeholder/shapes> a owl:Ontology ;
    sh:declare [ sh:prefix "scat" ; sh:namespace "https://example.org/scat-placeholder#"^^xsd:anyURI ] .

# SCAT-001: always-required fields (title, status); description when status is done
shape:RequiredField a sh:NodeShape ; scat:ruleId "SCAT-001" ; sh:targetClass scat:Page ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "required field is missing" ;
        sh:prefixes <https://example.org/scat-placeholder/shapes> ;
        sh:select """
            SELECT $this ?path WHERE {
              { BIND(scat:title AS ?path) FILTER NOT EXISTS { $this scat:title ?x } }
              UNION
              { BIND(scat:status AS ?path) FILTER NOT EXISTS { $this scat:status ?x } }
              UNION
              { $this scat:status "done" . BIND(scat:description AS ?path)
                FILTER NOT EXISTS { $this scat:description ?x } }
            }""" ] .

# SCAT-003: a link (frontmatter or body) to a page that does not exist
shape:LinkResolves a sh:NodeShape ; scat:ruleId "SCAT-003" ; sh:targetClass scat:Page ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "link target page does not exist" ;
        sh:prefixes <https://example.org/scat-placeholder/shapes> ;
        sh:select """
            SELECT $this ?path ?value WHERE { $this ?path ?value . ?value a scat:Missing . }""" ] .

# SCAT-004: a done coded record has every link type its TBox class requires (scat:requiresLink)
shape:RequiredLink a sh:NodeShape ; scat:ruleId "SCAT-004" ; sh:targetClass scat:Page ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "required link type is missing" ;
        sh:prefixes <https://example.org/scat-placeholder/shapes> ;
        sh:select """
            SELECT $this ?path WHERE {
              $this scat:status "done" ; a ?cls . ?cls scat:requiresLink ?path .
              FILTER NOT EXISTS { $this ?path ?x }
            }""" ] .

# SCAT-002: relation endpoint has the class the relation requires
shape:EndpointHeldby a sh:NodeShape ; sh:targetClass scat:StakeholderGroup ;
    sh:property shape:EpHeldby .
shape:EpHeldby a sh:PropertyShape ; scat:ruleId "SCAT-002" ; sh:path scat:heldby ;
    sh:class scat:Concern ; sh:message "relation endpoint has the wrong class" .
shape:EndpointAddresses a sh:NodeShape ; sh:targetClass scat:Concern ;
    sh:property shape:EpAddresses .
shape:EpAddresses a sh:PropertyShape ; scat:ruleId "SCAT-002" ; sh:path scat:addresses ;
    sh:class scat:Affordance ; sh:message "relation endpoint has the wrong class" .
shape:EndpointAttributes a sh:NodeShape ; sh:targetClass scat:Affordance ;
    sh:property shape:EpAttributes .
shape:EpAttributes a sh:PropertyShape ; scat:ruleId "SCAT-002" ; sh:path scat:attributes ;
    sh:class scat:Technology ; sh:message "relation endpoint has the wrong class" .

shape:EndpointCodedScenario a sh:NodeShape ; sh:targetClass scat:CodedScenario ;
    sh:property shape:EpCsGroups, shape:EpCsConcerns, shape:EpCsAffordances, shape:EpCsRaw .
shape:EpCsGroups a sh:PropertyShape ; scat:ruleId "SCAT-002" ; sh:path scat:groups ;
    sh:class scat:StakeholderGroup ; sh:message "relation endpoint has the wrong class" .
shape:EpCsConcerns a sh:PropertyShape ; scat:ruleId "SCAT-002" ; sh:path scat:concerns ;
    sh:class scat:Concern ; sh:message "relation endpoint has the wrong class" .
shape:EpCsAffordances a sh:PropertyShape ; scat:ruleId "SCAT-002" ; sh:path scat:affordances ;
    sh:class scat:Affordance ; sh:message "relation endpoint has the wrong class" .
shape:EpCsRaw a sh:PropertyShape ; scat:ruleId "SCAT-002" ; sh:path scat:raw ;
    sh:class scat:RawScenario ; sh:message "relation endpoint has the wrong class" .

shape:EndpointCodedArchitecture a sh:NodeShape ; sh:targetClass scat:CodedArchitecture ;
    sh:property shape:EpCaConcerns, shape:EpCaAffordances, shape:EpCaTechnologies, shape:EpCaRaw .
shape:EpCaConcerns a sh:PropertyShape ; scat:ruleId "SCAT-002" ; sh:path scat:concerns ;
    sh:class scat:Concern ; sh:message "relation endpoint has the wrong class" .
shape:EpCaAffordances a sh:PropertyShape ; scat:ruleId "SCAT-002" ; sh:path scat:affordances ;
    sh:class scat:Affordance ; sh:message "relation endpoint has the wrong class" .
shape:EpCaTechnologies a sh:PropertyShape ; scat:ruleId "SCAT-002" ; sh:path scat:technologies ;
    sh:class scat:Technology ; sh:message "relation endpoint has the wrong class" .
shape:EpCaRaw a sh:PropertyShape ; scat:ruleId "SCAT-002" ; sh:path scat:raw ;
    sh:class scat:RawArchitecture ; sh:message "relation endpoint has the wrong class" .

shape:EndpointRawScenario a sh:NodeShape ; sh:targetClass scat:RawScenario ;
    sh:property shape:EpRsCoded .
shape:EpRsCoded a sh:PropertyShape ; scat:ruleId "SCAT-002" ; sh:path scat:coded ;
    sh:class scat:CodedScenario ; sh:message "relation endpoint has the wrong class" .
shape:EndpointRawArchitecture a sh:NodeShape ; sh:targetClass scat:RawArchitecture ;
    sh:property shape:EpRaCoded .
shape:EpRaCoded a sh:PropertyShape ; scat:ruleId "SCAT-002" ; sh:path scat:coded ;
    sh:class scat:CodedArchitecture ; sh:message "relation endpoint has the wrong class" .
