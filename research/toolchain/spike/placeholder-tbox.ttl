@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sp:   <https://example.org/scpt-spike#> .

# PLACEHOLDER TBox for the WP2 spike. Own namespace; no adopted ontology (WP1 decides).
# Field annotations: sp:requiredField / sp:optionalField hold frontmatter key names.
# A key whose name is an object-property below (stakeholder, concern, property, technology)
# holds a "[[wikilink]]" to a page of the property's range class.

sp:Class a owl:Class ; rdfs:label "SCPT class" .

sp:StakeholderGroup a owl:Class, sp:Class ;
    rdfs:label "Stakeholder group" ;
    sp:requiredField "name", "description" ;
    sp:optionalField "size_note" .

sp:Concern a owl:Class, sp:Class ;
    rdfs:label "Concern" ;
    sp:requiredField "name", "description" ;
    sp:optionalField "category" .

sp:Property a owl:Class, sp:Class ;
    rdfs:label "Property" ;
    sp:requiredField "name", "description" ;
    sp:optionalField "metric" .

sp:Technology a owl:Class, sp:Class ;
    rdfs:label "Technology" ;
    sp:requiredField "name", "description" ;
    sp:optionalField "homepage" .

# Relations as classes; endpoints are object properties with domain = the relation class.
sp:Heldby a owl:Class, sp:Class ;
    rdfs:label "Held by" ;
    sp:requiredField "stakeholder", "concern" ;
    sp:optionalField "rationale" .

sp:Addresses a owl:Class, sp:Class ;
    rdfs:label "Addresses" ;
    sp:requiredField "concern", "property" ;
    sp:optionalField "rationale" .

sp:Attributes a owl:Class, sp:Class ;
    rdfs:label "Attributes" ;
    sp:requiredField "property", "technology" ;
    sp:optionalField "rationale" .

sp:heldbyStakeholder a owl:ObjectProperty ; rdfs:label "stakeholder" ;
    rdfs:domain sp:Heldby ; rdfs:range sp:StakeholderGroup .
sp:heldbyConcern a owl:ObjectProperty ; rdfs:label "concern" ;
    rdfs:domain sp:Heldby ; rdfs:range sp:Concern .
sp:addressesConcern a owl:ObjectProperty ; rdfs:label "concern" ;
    rdfs:domain sp:Addresses ; rdfs:range sp:Concern .
sp:addressesProperty a owl:ObjectProperty ; rdfs:label "property" ;
    rdfs:domain sp:Addresses ; rdfs:range sp:Property .
sp:attributesProperty a owl:ObjectProperty ; rdfs:label "property" ;
    rdfs:domain sp:Attributes ; rdfs:range sp:Property .
sp:attributesTechnology a owl:ObjectProperty ; rdfs:label "technology" ;
    rdfs:domain sp:Attributes ; rdfs:range sp:Technology .

# Status vocabulary: stub -> draft -> done (rank gives the order).
sp:Status a owl:Class ; rdfs:label "Status" .
sp:stub  a sp:Status ; rdfs:label "stub"  ; sp:rank 0 .
sp:draft a sp:Status ; rdfs:label "draft" ; sp:rank 1 .
sp:done  a sp:Status ; rdfs:label "done"  ; sp:rank 2 .
sp:hasStatus a owl:ObjectProperty ; rdfs:range sp:Status .
