# scat.ttl : the SCAT TBox (mission deliverable D-1), as rebuilt for the layout of D-088.
#
# How to read this file
#   * Page types are the classes with a scat:key (their slug): six in all: the four node types (group, concern,
#     affordance, technology), the narrative, and the index. Only the first five are pages of Markdown with
#     frontmatter; an index is an Obsidian Base file the tool generates, with no frontmatter and no fields.
#   * An edge is no page and no field. It is one row of a narrative's table. The three edge types are
#     the properties scat:Heldby, scat:Addresses and scat:Attributes (formal identifiers; their labels are the plain
#     words "holds", "is addressed by" and "is provided by"). Each states its slug, its verb and the node types of its
#     two ends, in order (scat:endpointOrder). A row's type is fixed by the layers of its ends.
#   * A page type lists its fields with scat:requiredField, scat:optionalField and scat:discouragedField. Each field
#     is a scat:Field with a frontmatter key. No page type has a link field now (no field has scat:targetType): every
#     link is in a page's text, and the narrative's table says which links are edges.
#   * scat:requiredField means required once the page's status is scat:done. A field's scat:requiredFrom says from
#     which status it is required; type, status and title are required from scat:stub, so they are present at every
#     status. Types with scat:carriesStatus false have no status: their required fields always apply.
#   * The narrative states how its edges are read: scat:tableHeading (the heading the table sits under) and
#     scat:tableColumns (the columns, in order; each says by scat:cellHolds what its cell holds). A tool reads the
#     table from here and from the edge types, with no other source (R-13).
#   * Terms this file does not state (page names, rule ids, messages, the group cap, which is vault
#     configuration, the form of the Base files, how a table is written) are left to the page contracts and the rule
#     catalogue. An edge's status is derived from the narratives that tell it, and is stated in the contracts.
#
# What this version adds to the earlier vocabulary (D-088)
#   Added:    scat:EdgeType (the class of the three edge types), scat:slug (an edge type's CLI and API spelling),
#             scat:TableColumn, scat:tableHeading, scat:tableColumns and scat:cellHolds (the table reading), the
#             field scat:field-kind, and the type scat:Narrative with scat:Index.
#   Changed:  scat:endpointOrder now lists the node types of an edge type's two ends (it listed endpoint fields of a
#             relation page); scat:verb now gives an edge type's verb; scat:valueSet is used for status, timeframe
#             and kind; the stakeholder-group type is the group type (scat:Group, key "group").
#   Kept:     scat:key, scat:requiredField, scat:optionalField, scat:discouragedField, scat:requiredFrom,
#             scat:targetType, scat:valueSet, scat:carriesStatus, scat:mapsTo, scat:pageDescription, the status values,
#             and the source, authored and verification annotations. scat:discouragedField and scat:targetType are
#             declared but no type uses them now; they stay so the reader needs small edits only.
#   Removed:  the relation page types, the scenario and architecture raw and coded record types and their fields, the
#             class pages and scat:ClassPageName with its two properties, the fields notes, indexes, group
#             and its siblings, the old conflict field and property (a relationship annotation now says it), involves and coded, scat:single, scat:discouragedBodyLink,
#             and the ontology-level scat:unlistedLinkLevel and scat:wrongTargetLevel (there is no link field to grade).
#
# Provenance of wording (every term below carries one of these)
#   scat:source        the source the wording is adopted or adapted from, as far as reached.
#   scat:authored      the wording is ours; the value gives the reason.
#   scat:verification  "verified"   checked against the text of the source it cites;
#                      "unverified" adopted wording not checked against the primary source
#                                   (the cited secondary source says where it was read);
#                      "authored"   our wording, so there is no source text to check.

@prefix scat:    <https://w3id.org/scat#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema:  <https://schema.org/> .

<https://w3id.org/scat> a owl:Ontology ;
    rdfs:label "SCAT ontology" ;
    owl:versionInfo "0.2.0" ;
    rdfs:comment "TBox for scat-kg: four SKOS-based node types, three edge types, and six page types (the four node types, the narrative and the index), with the fields of each and how a narrative's table of edges is read. The IRI base is unregistered until release." .

##############################################################################
# The four node types (MISSION G1). Instances are skos:Concepts.
##############################################################################

scat:Group a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Group" ;
    skos:definition "A group of individuals or organizations that have a right, share, claim or interest in a system, or in its possession of characteristics that meet their needs and expectations. The type is a group, not a named person; how many groups a vault may hold is set in the vault's configuration, not here." ;
    skos:closeMatch <https://sebokwiki.org/wiki/Stakeholder_(glossary)> ;
    scat:source "SEBoK glossary, Stakeholder, entry 1 (v2.14), which credits ISO/IEC/IEEE 15288:2015. Paraphrased. The standard itself was not read. 15288 says \"individual or organization\"; \"group\" is our usage." ;
    scat:verification "unverified" ;
    scat:key "group" ;
    scat:pageDescription "One page per group: who the group is, in the group's own terms. The concerns it holds are told by narratives." ;
    scat:requiredField scat:field-type, scat:field-status, scat:field-title, scat:field-description .

scat:Concern a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Concern" ;
    skos:definition "Any interest in a system." ;
    skos:closeMatch <http://www.iso-architecture.org/ieee-1471/cm/> ;
    scat:source "ISO/IEC/IEEE 42010 community site, conceptual-model page (first-edition wording: \"A Concern is any interest in the system\"). The 2022 edition of the standard was unreachable (HTTP 403), so whether it words this the same was not checked. SEBoK has no Concern entry." ;
    scat:verification "unverified" ;
    scat:key "concern" ;
    scat:pageDescription "One page per concern: what the interest is. Who holds it and what addresses it are told by narratives." ;
    scat:requiredField scat:field-type, scat:field-status, scat:field-title, scat:field-description .

scat:Affordance a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Affordance" ;
    skos:definition "What a technology offers to those in an action situation, for good or ill: a possibility of action it provides, taken as a relation between the technology and its would-be users and not as a property of either alone." ;
    skos:closeMatch <https://sebokwiki.org/wiki/Capability_(glossary)> ;
    rdfs:seeAlso <https://www.w3.org/2019/wot/td#InteractionAffordance> ;
    scat:source "After Gibson, The Ecological Approach to Visual Perception (1979), p. 119, as quoted by Toyoshima (2017, CEUR Vol-2205). Gibson's book is an image-only scan and was not read directly; the paraphrase and its adaptation to technology are ours. SEBoK Capability is a near match (outcome-centred); WoT td:InteractionAffordance describes a Thing for machine consumers, so it is a pointer only." ;
    scat:verification "unverified" ;
    scat:key "affordance" ;
    scat:pageDescription "One page per affordance: what is offered. The technologies that provide it are told by narratives." ;
    scat:requiredField scat:field-type, scat:field-status, scat:field-title, scat:field-description .

scat:Technology a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Technology" ;
    skos:definition "A discrete part of a system that can be implemented to fulfil specified requirements." ;
    skos:closeMatch <https://sebokwiki.org/wiki/System_Element_(glossary)> ;
    scat:source "SEBoK glossary, System Element (v2.14), which credits ISO/IEC/IEEE 15288:2015. Paraphrased. The standard itself was not read. SEBoK has no Technology entry, so the label \"Technology\" is ours." ;
    scat:verification "unverified" ;
    scat:key "technology" ;
    scat:pageDescription "One page per technology: what the part is." ;
    scat:requiredField scat:field-type, scat:field-status, scat:field-title, scat:field-description .

##############################################################################
# The three edge types (MISSION G1). Each joins two nodes in neighbouring layers,
# read as an ordered pair. An edge is one row of a narrative's table; the knowledge
# graph holds one edge per (type, from, to) and names every narrative with a row for it.
##############################################################################

scat:EdgeType a owl:Class ;
    rdfs:label "Edge type" ;
    skos:definition "One of the three types of edge. Its rdfs:label is the plain word for it; scat:slug is its spelling in the command line and the API; scat:verb is the verb a row's type cell may hold; scat:endpointOrder gives the node types of its from end and its to end, in that order." ;
    scat:authored "Carries the three edge types as data so no tool keeps a copy (R-13, D-088). Deliberately not a page type: an edge is no page, so it has no scat:key." ;
    scat:verification "authored" .

scat:Heldby a owl:ObjectProperty, scat:EdgeType ;
    rdfs:label "holds" ;
    rdfs:domain scat:Group ;
    rdfs:range scat:Concern ;
    skos:definition "Pairs a group with a concern that the group holds. Many-to-many: one concern may be held by several groups, and one group may hold several concerns. Read the pair as (group, concern). At most one edge per pair." ;
    scat:source "The idea that stakeholders hold concerns is ISO/IEC/IEEE 42010's, as shown on its community site (first-edition wording). 42010 publishes no IRI, and prov:wasAttributedTo means authorship, not holding." ;
    scat:authored "Authored IRI and pair direction (group, concern) as MISSION G1 orders the pair; the formal name reads inversely, so the definition fixes the direction, and the label gives the plain word." ;
    scat:verification "authored" ;
    scat:slug "holds" ;
    scat:verb "holds" ;
    scat:endpointOrder ( scat:Group scat:Concern ) .

scat:Addresses a owl:ObjectProperty, scat:EdgeType ;
    rdfs:label "is addressed by" ;
    rdfs:domain scat:Concern ;
    rdfs:range scat:Affordance ;
    skos:definition "Pairs a concern with an affordance that addresses it. Many-to-many. Read the pair as (concern, affordance). At most one edge per pair." ;
    scat:authored "No usable IRI exists: cds:addresses is bound to cds:Term and lives in one repository; the pair direction (concern, affordance) follows MISSION G1, and the label reads in that direction." ;
    scat:verification "authored" ;
    scat:slug "addressed-by" ;
    scat:verb "is addressed by" ;
    scat:endpointOrder ( scat:Concern scat:Affordance ) .

scat:Attributes a owl:ObjectProperty, scat:EdgeType ;
    rdfs:label "is provided by" ;
    rdfs:domain scat:Affordance ;
    rdfs:range scat:Technology ;
    skos:definition "Pairs an affordance with a technology that provides it. Many-to-many. Read the pair as (affordance, technology). At most one edge per pair." ;
    scat:authored "No source found for an affordance-to-technology relation; the pair direction (affordance, technology) follows MISSION G1, and the label reads in that direction." ;
    scat:verification "authored" ;
    scat:slug "provided-by" ;
    scat:verb "is provided by" ;
    scat:endpointOrder ( scat:Affordance scat:Technology ) .

##############################################################################
# The narrative and the index (the two page types that are not nodes)
##############################################################################

scat:Narrative a owl:Class ;
    rdfs:label "Narrative" ;
    skos:definition "One account drawn from the field notes, on one page: the account in the page body with links where names appear, an optional list of what it refers to beyond the text, and a table of the edges it tells. Usually a scenario (people doing things over time) or an architecture (how parts are put together into tools that offer affordances), sometimes neither." ;
    scat:authored "Authored in SCAT; the one page of D-088 that replaces the raw and coded pairs, the relation pages and their class pages. Scenario and architecture are the optional kind field, not types of page." ;
    scat:verification "authored" ;
    scat:key "narrative" ;
    scat:pageDescription "A narrative: the account in the page body, with links where names appear, and under the heading Edges told a table with one row for each edge the account tells." ;
    scat:requiredField scat:field-type, scat:field-status, scat:field-title, scat:field-description, scat:field-timeframe ;
    scat:optionalField scat:field-kind ;
    scat:tableHeading "Edges told" ;
    scat:tableColumns ( scat:column-type scat:column-from scat:column-to scat:column-note ) .

scat:Index a owl:Class ;
    rdfs:label "Index" ;
    skos:definition "The page the tool generates for a type, listing its entries. It is one Obsidian Base file per type of node and of narrative; it has no frontmatter and no fields, and the loader ignores it." ;
    scat:authored "D-088: Bases that the tool generates once, so an index never goes stale." ;
    scat:verification "authored" ;
    scat:key "index" ;
    scat:pageDescription "An index: a generated Obsidian Base listing the pages of one type." ;
    scat:carriesStatus false .

##############################################################################
# The table of edges: its columns
##############################################################################

scat:TableColumn a owl:Class ;
    rdfs:label "Table column" ;
    skos:definition "One column of a narrative's table of edges. Its rdfs:label is the column's name in the header row; scat:cellHolds says what its cells hold." ;
    scat:authored "Carries the column names, their order and the meaning of each cell as data, so the loader reads the table from the TBox alone (R-13)." ;
    scat:verification "authored" .

scat:column-type a scat:TableColumn ;
    rdfs:label "type" ;
    skos:definition "The edge type of the row: the verb or the slug of one of the three edge types." ;
    scat:authored "D-088, with the verb or the slug accepted so a person writes the plain words." ;
    scat:verification "authored" ;
    scat:cellHolds "edge-type" .

scat:column-from a scat:TableColumn ;
    rdfs:label "from" ;
    skos:definition "The node at the first end of the pair: one link." ;
    scat:authored "D-088." ;
    scat:verification "authored" ;
    scat:cellHolds "from" .

scat:column-to a scat:TableColumn ;
    rdfs:label "to" ;
    skos:definition "The node at the second end of the pair: one link." ;
    scat:authored "D-088." ;
    scat:verification "authored" ;
    scat:cellHolds "to" .

scat:column-note a scat:TableColumn ;
    rdfs:label "note" ;
    skos:definition "Free text on how this narrative tells this pair. It may be empty and has no meaning to the tool." ;
    scat:authored "D-088: two narratives telling a pair are two tellings, each with its own note." ;
    scat:verification "authored" ;
    scat:cellHolds "note" .

##############################################################################
# Fields
##############################################################################

scat:Field a owl:Class ;
    rdfs:label "Field" ;
    skos:definition "A frontmatter key that a page type may carry. A field with scat:targetType is a link field, whose value is a list of wikilinks; one with scat:valueSet takes a value from that set; any other takes text." ;
    scat:authored "Needed so required and optional fields, targets and value sets are stated once and a tool can generate models from them (R-13)." ;
    scat:verification "authored" .

scat:field-type a scat:Field ;
    rdfs:label "type" ;
    skos:definition "The page's type: the scat:key of its page type." ;
    scat:authored "Frontmatter key chosen for tools to dispatch on." ;
    scat:verification "authored" ;
    scat:key "type" ; scat:mapsTo rdf:type ; scat:requiredFrom scat:stub .

scat:field-status a scat:Field ;
    rdfs:label "status" ;
    skos:definition "The page's lifecycle status, one of stub, draft and done." ;
    scat:authored "MISSION G3." ;
    scat:verification "authored" ;
    scat:key "status" ; scat:mapsTo scat:status ; scat:valueSet scat:StatusValues ; scat:requiredFrom scat:stub .

scat:field-title a scat:Field ;
    rdfs:label "title" ;
    skos:definition "The page's name as a person reads it." ;
    scat:authored "Frontmatter key; not the file name, whose rule is decided elsewhere." ;
    scat:verification "authored" ;
    scat:key "title" ; scat:mapsTo dcterms:title ; scat:requiredFrom scat:stub .

scat:field-description a scat:Field ;
    rdfs:label "description" ;
    skos:definition "A short description of what the page is about; the short description shown in an index." ;
    scat:authored "MISSION G2 (an index shows name, short description, link)." ;
    scat:verification "authored" ;
    scat:key "description" ; scat:mapsTo dcterms:description ; scat:requiredFrom scat:done .

scat:field-timeframe a scat:Field ;
    rdfs:label "timeframe" ;
    skos:definition "On a narrative: whether it tells what happened (past), what would or will happen (future), or both (mixed)." ;
    scat:authored "Mission Amendment 3; chief engineer's wording (log D-057). Carried over from the raw scenario and raw architecture to the one narrative page (D-088)." ;
    scat:verification "authored" ;
    scat:key "timeframe" ; scat:valueSet ( "past" "future" "mixed" ) ; scat:requiredFrom scat:done .

scat:field-kind a scat:Field ;
    rdfs:label "kind" ;
    skos:definition "On a narrative: whether it is a scenario or an architecture. A narrative that is neither leaves it out." ;
    scat:authored "D-088 and the PM's build-stage defaults: one narrative page, with scenario and architecture as an optional mark." ;
    scat:verification "authored" ;
    scat:key "kind" ; scat:valueSet ( "scenario" "architecture" ) .

##############################################################################
# Status
##############################################################################

scat:status a owl:ObjectProperty ;
    rdfs:label "Status" ;
    skos:definition "Relates a page to its lifecycle status value: stub, draft or done." ;
    skos:closeMatch schema:creativeWorkStatus ;
    scat:authored "Authored in place of adopting schema:creativeWorkStatus, which schema.org keeps in its pending area and may change; the tools read the key and gain nothing from the adopted IRI (stack C, log D-028), while the instability is a risk. The closeMatch keeps the link for any export. Source for the pending status: schema.org v30.1 as read in the ontology trade study." ;
    scat:verification "authored" .

scat:StatusValues a skos:OrderedCollection ;
    rdfs:label "Status values" ;
    skos:definition "The status values in lifecycle order: stub, then draft, then done." ;
    scat:authored "MISSION G3; the order is carried by skos:memberList so no ordering property is needed." ;
    scat:verification "authored" ;
    skos:memberList ( scat:stub scat:draft scat:done ) .

scat:stub a skos:Concept ;
    skos:prefLabel "stub" ; skos:notation "stub" ;
    skos:definition "The page exists because something links to it, or has just been started; its content is unfinished. A stub is never an error for being unfinished." ;
    scat:authored "MISSION G3 and R-3." ;
    scat:verification "authored" .

scat:draft a skos:Concept ;
    skos:prefLabel "draft" ; skos:notation "draft" ;
    skos:definition "The page is being written; its contract is not yet met." ;
    scat:authored "MISSION G3." ;
    scat:verification "authored" .

scat:done a skos:Concept ;
    skos:prefLabel "done" ; skos:notation "done" ;
    skos:definition "The author judges the page complete; the full contract applies, including every required field." ;
    scat:authored "MISSION G3 and R-3." ;
    scat:verification "authored" .

##############################################################################
# Vocabulary used above to state page types, edge types, tables and fields
##############################################################################

scat:carriesStatus a owl:AnnotationProperty ;
    skos:definition "Whether pages of this type carry a status. Where it is false, the page has no status field and every required field applies at all times. Where absent, the type carries a status." ;
    scat:authored "Replaces special-casing in tools (WP4-R3); here it marks the index, which is not a page of frontmatter." ;
    scat:verification "authored" .

scat:key a owl:AnnotationProperty ;
    skos:definition "The text a tool matches on: the slug of a page type (the value of a page's type field), or the frontmatter key of a field." ;
    scat:authored "Needed so tools need no other file for names (R-13)." ;
    scat:verification "authored" .

scat:pageDescription a owl:AnnotationProperty ;
    skos:definition "A short description of what a page of this type is." ;
    scat:authored "Distinct from skos:definition, which defines the type itself and may be adopted wording." ;
    scat:verification "authored" .

scat:requiredField a owl:AnnotationProperty ;
    skos:definition "A field a page of this type must carry once its status is done (see scat:requiredFrom for the exceptions)." ;
    scat:authored "R-3: the full contract applies at done." ;
    scat:verification "authored" .

scat:optionalField a owl:AnnotationProperty ;
    skos:definition "A field a page of this type may carry." ;
    scat:authored "MISSION G1." ;
    scat:verification "authored" .

scat:discouragedField a owl:AnnotationProperty ;
    skos:definition "A field a page of this type may carry but that is graded at warning level when present and non-empty. No page type uses it in this version." ;
    scat:authored "Kept from the earlier vocabulary so the reader changes little; the guidance it encoded (a scenario naming a technology) is not a rule now." ;
    scat:verification "authored" .

scat:endpointOrder a owl:AnnotationProperty ;
    skos:definition "Stated on an edge type: an RDF list of two node types, the type of the from end and then the type of the to end. A tool that names or fills an edge's ends takes the order from here." ;
    scat:authored "Was the order of a relation page's two endpoint fields (log D-032 ruling 2); now the order of an edge type's two node types, so tools take it from the TBox (R-13)." ;
    scat:verification "authored" .

scat:verb a owl:AnnotationProperty ;
    skos:definition "On an edge type: the verb that reads between its two ends, and that a row's type cell may hold in place of the slug." ;
    scat:authored "Log D-035 ruling 2, carried to the edge types by D-088." ;
    scat:verification "authored" .

scat:slug a owl:AnnotationProperty ;
    skos:definition "On an edge type: its spelling in the command line and the API, and the other spelling a row's type cell may hold." ;
    scat:authored "The PM's build-stage defaults on D-088." ;
    scat:verification "authored" .

scat:tableHeading a owl:AnnotationProperty ;
    skos:definition "On a narrative: the name of the heading under which its table of edges sits. The first table under it, at any heading level, is the table; the name is matched without regard to case." ;
    scat:authored "D-088 and the PM's build-stage defaults; stated here so the loader needs no other source (R-13)." ;
    scat:verification "authored" .

scat:tableColumns a owl:AnnotationProperty ;
    skos:definition "On a narrative: an RDF list of its table's columns, in the order they are written." ;
    scat:authored "D-088 and the PM's build-stage defaults (R-13)." ;
    scat:verification "authored" .

scat:cellHolds a owl:AnnotationProperty ;
    skos:definition "On a table column: what its cells hold, one of \"edge-type\", \"from\", \"to\" or \"note\"." ;
    scat:authored "Says which cell holds what, apart from the column's name in the header row." ;
    scat:verification "authored" .

scat:mapsTo a owl:AnnotationProperty ;
    skos:definition "The RDF property a field becomes when a page is read into the graph." ;
    scat:authored "Lets the vault be read as an ABox (MISSION G2) without a second table." ;
    scat:verification "authored" .

scat:targetType a owl:AnnotationProperty ;
    skos:definition "The page type every target of a link field must have. Its presence makes a field a link field. No field uses it in this version." ;
    scat:authored "Kept from the earlier vocabulary so the reader changes little." ;
    scat:verification "authored" .

scat:requiredFrom a owl:AnnotationProperty ;
    skos:definition "The status from which a field is required when its page type lists it as required. A field without it is required from done." ;
    scat:authored "Needed because type, status and title are required at every status while the rest are required at done (R-3)." ;
    scat:verification "authored" .

scat:valueSet a owl:AnnotationProperty ;
    skos:definition "The ordered list of values a field may take: a skos:OrderedCollection of concepts (status) or an RDF list of literals (timeframe and kind)." ;
    scat:authored "Used for status and timeframe (and kind)." ;
    scat:verification "authored" .

scat:source a owl:AnnotationProperty ;
    skos:definition "The published source a term's wording is adopted or adapted from, with what was and was not reached." ;
    scat:authored "Provenance of adopted wording (WP4-R2)." ;
    scat:verification "authored" .

scat:authored a owl:AnnotationProperty ;
    skos:definition "The reason a term is authored here and not adopted, or how its authored wording was settled." ;
    scat:authored "Provenance of authored wording (WP4-R2)." ;
    scat:verification "authored" .

scat:verification a owl:AnnotationProperty ;
    skos:definition "Whether a term's wording was checked: \"verified\" (against the text of the source it cites), \"unverified\" (adopted wording not checked against the primary source) or \"authored\" (our wording, nothing to check)." ;
    scat:authored "The marker WP4-R2 asks for." ;
    scat:verification "authored" .
